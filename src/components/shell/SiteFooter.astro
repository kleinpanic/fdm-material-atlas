---
interface FooterLink {
  readonly label: string;
  readonly href: string;
}

interface Props {
  links: readonly FooterLink[];
}

const { links } = Astro.props;
---

<footer class="site-footer">
  <div class="page-shell site-footer__inner">
    <p>
      Material guidance is comparative. Check current TDS and SDS documents
      before safety-critical use.
    </p>
    <ul aria-label="Available routes">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: var(--size-rule-strong) solid var(--color-ink-strong);
    background: var(--color-surface);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--spacing-4);
    padding-block: var(--spacing-6);
  }

  .site-footer p,
  .site-footer ul {
    margin: 0;
  }

  .site-footer p {
    max-inline-size: var(--width-reading);
  }

  .site-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2) var(--spacing-4);
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-inline-size: var(--size-target-min);
    min-block-size: var(--size-target-min);
  }

  @media (min-width: 64rem) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }
</style>
