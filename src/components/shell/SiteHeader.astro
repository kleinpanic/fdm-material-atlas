---
interface NavigationItem {
  readonly label: string;
  readonly href: string;
  readonly current: boolean;
}

interface Props {
  homeHref: string;
  navigation: readonly NavigationItem[];
}

const { homeHref, navigation } = Astro.props;
---

<header class="site-header">
  <div class="page-shell site-header__inner">
    <div class="site-identity">
      <a class="site-identity__name" href={homeHref}>FDM Material Atlas</a>
      <p class="site-identity__descriptor">
        Compare material behavior, process needs, and evidence.
      </p>
    </div>

    <nav aria-label="Primary navigation">
      <ul class="compact-navigation site-navigation">
        {navigation.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="site-navigation__repository">
          <a
            class="repository-link"
            href="https://github.com/kleinpanic/fdm-material-atlas"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View source on GitHub (opens in a new tab)"
          >
            <span class="repository-link__compact">GitHub</span>
            <span class="repository-link__wide">View on GitHub</span>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-block-end: var(--size-rule-strong) solid var(--color-ink-strong);
    background: var(--color-surface);
  }

  .site-header__inner {
    display: grid;
    min-inline-size: 0;
    gap: var(--spacing-4);
    padding-block: var(--spacing-4);
  }

  .site-header nav,
  .site-navigation {
    min-inline-size: 0;
    max-inline-size: 100%;
  }

  .site-identity {
    display: grid;
    gap: var(--spacing-1);
  }

  .site-identity__name {
    display: inline-flex;
    inline-size: fit-content;
    min-inline-size: var(--size-target-min);
    min-block-size: var(--size-target-min);
    align-items: center;
    color: var(--color-ink-strong);
    font-size: var(--text-heading);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .site-identity__descriptor {
    max-inline-size: var(--width-reading);
    margin: 0;
    color: var(--color-ink);
  }

  .site-navigation {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-1) var(--spacing-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-navigation a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--size-target-min);
    min-inline-size: var(--size-target-min);
    padding-inline: var(--spacing-2);
    color: var(--color-ink-strong);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .site-navigation .repository-link {
    gap: var(--spacing-1);
    border: var(--size-rule) solid var(--color-accent);
    background: var(--color-accent);
    color: var(--color-page);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .site-navigation .repository-link:hover {
    border-color: var(--color-ink-strong);
    background: var(--color-ink-strong);
  }

  .repository-link__wide {
    display: none;
  }

  @media (max-width: 39.999rem) {
    .site-navigation { overflow: visible; }
  }

  @media (min-width: 64rem) {
    .site-header__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .site-navigation {
      justify-content: flex-end;
      gap: var(--spacing-2);
    }

    .repository-link__compact { display: none; }
    .repository-link__wide { display: inline; }
  }
</style>
