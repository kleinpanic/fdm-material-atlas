---
import type { DecisionLaneMembership } from "../../domain/decision-lanes/membership.ts";
import { internalHref } from "../../lib/routes.ts";

type MaterialLink = {
  readonly id: string;
  readonly name: string;
  readonly slug: string;
};

type Props = {
  readonly lanes: readonly DecisionLaneMembership[];
  readonly materials: ReadonlyMap<string, MaterialLink>;
  readonly base: string;
};

const { lanes, materials, base } = Astro.props;

const fieldLabels: Readonly<Record<string, string>> = Object.freeze({
  "guidance.bestSuitedFor": "Recommended uses",
  "process.enclosure": "Enclosure requirement",
  "process.hardenedNozzle": "Wear-resistant nozzle",
  "process.printDifficulty": "Print difficulty",
  "process.ventilation": "Ventilation category",
  "properties.chemicalResistance": "Chemical resistance",
  "properties.creepSustainedLoad": "Creep under load",
  "properties.flexibility": "Flexibility",
  "properties.impactResistance": "Impact resistance",
  "properties.moistureSensitivity": "Moisture sensitivity",
  "properties.outdoorUv": "Outdoor and UV behavior",
  "properties.wearAbrasion": "Wear and abrasion",
  "serviceTemperature.maximum": "Maximum service temperature",
});

function fieldLabel(field: string): string {
  return fieldLabels[field] ?? field;
}

function materialFor(id: string): MaterialLink {
  const material = materials.get(id);
  if (material === undefined) throw new Error("MAP_MATERIAL_MISSING");
  return material;
}
---

<nav class="map-index" aria-label="Decision paths">
  <p class="map-index__label">Choose a need</p>
  <ol>
    {lanes.map((lane, index) => (
      <li>
        <a href={`#${lane.id}`}>
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          {lane.label}
        </a>
      </li>
    ))}
  </ol>
</nav>

<div class="decision-board" aria-label="Material decision paths">
  {lanes.map((lane, laneIndex) => (
    <section
      id={lane.id}
      class="decision-lane"
      aria-labelledby={`${lane.id}-heading`}
      style={`--lane-index: ${laneIndex}`}
      tabindex="-1"
    >
      <header class="decision-lane__header">
        <span class="decision-lane__number" aria-hidden="true">
          {String(laneIndex + 1).padStart(2, "0")}
        </span>
        <div>
          <p class="technical-eyebrow">Decision path</p>
          <h2 id={`${lane.id}-heading`}>{lane.label}</h2>
        </div>
        <p class="decision-lane__count">
          <strong>{lane.candidateMaterialIds.length}</strong>
          <span>live {lane.candidateMaterialIds.length === 1 ? "candidate" : "candidates"}</span>
        </p>
      </header>

      <ol class="decision-flow" aria-label={`${lane.label} decision flow`}>
        <li class="decision-stage decision-stage--need">
          <p class="decision-stage__label"><span>01</span> Need</p>
          <p class="decision-stage__lead">{lane.need}</p>
        </li>

        <li class="decision-stage decision-stage--check">
          <p class="decision-stage__label"><span>02</span> Property to check</p>
          <ul class="property-list">
            {lane.propertyChecks.map((field) => <li>{fieldLabel(field)}</li>)}
          </ul>
        </li>

        <li class="decision-stage decision-stage--candidates">
          <p class="decision-stage__label"><span>03</span> Live candidates</p>
          <ul class="candidate-list">
            {lane.candidateMaterialIds.map((materialId) => {
              const material = materialFor(materialId);
              return (
                <li>
                  <a href={internalHref(base, { id: "material", slug: material.slug })}>
                    <span class="candidate-list__marker" aria-hidden="true"></span>
                    {material.name}
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </li>

        <li class="decision-stage decision-stage--verify">
          <p class="decision-stage__label"><span>04</span> Verify / process gates</p>
          <ul class="verification-list">
            {lane.verification.map((item) => <li>{item}</li>)}
          </ul>

          {lane.processGates.length > 0 && (
            <div class="gate-list" aria-label="Process gates">
              {lane.processGates.map((gate) => (
                <details class="process-gate">
                  <summary>
                    <span class="process-gate__icon" aria-hidden="true">!</span>
                    <span>{gate.label}</span>
                    <span class="process-gate__expand" aria-hidden="true">+</span>
                  </summary>
                  <div>
                    <p><strong>Requirement:</strong> {gate.requirement}</p>
                    <p><strong>Confirm:</strong> {gate.verification}</p>
                  </div>
                </details>
              ))}
            </div>
          )}

          {lane.indeterminateMaterialIds.length > 0 && (
            <details class="evidence-gap">
              <summary>{lane.indeterminateMaterialIds.length} records need more evidence</summary>
              <p>
                These materials are outside the live candidate set because a required property is
                unknown or conditional.
              </p>
            </details>
          )}
        </li>
      </ol>
    </section>
  ))}
</div>
