---
import { DataExplorerIsland } from "../../components/data-explorer/DataExplorerIsland.tsx";
import { buildDataExplorerModel } from "../../features/data-explorer/model.ts";
import { encodeDataExplorerPayload } from "../../features/data-explorer/payload.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPublicAtlas } from "../../lib/public-atlas.ts";
import { internalHref } from "../../lib/routes.ts";
import "../../styles/data-explorer.css";

const base = import.meta.env.BASE_URL;
const model = buildDataExplorerModel(loadPublicAtlas(), base);
const payload = encodeDataExplorerPayload(model);
const homeHref = internalHref(base, { id: "home" });
const materialsHref = internalHref(base, { id: "materials" });
const methodHref = internalHref(base, { id: "method" });
const compareHref = internalHref(base, { id: "compare" });
const mapHref = internalHref(base, { id: "map" });
const dataHref = internalHref(base, { id: "data" });
const navigation = [
  { label: "Material selector", href: homeHref, current: false },
  { label: "Material atlas", href: materialsHref, current: false },
  { label: "Compare", href: compareHref, current: false },
  { label: "Map", href: mapHref, current: false },
  { label: "Data", href: dataHref, current: true },
  { label: "Method", href: methodHref, current: false },
] as const;
const breadcrumbs = [
  { label: "Home", href: homeHref },
  { label: "Material data", current: true },
] as const;
const footerLinks = navigation.map(({ label, href }) => ({ label, href }));
---

<BaseLayout
  title="Material data explorer | FDM Material Atlas"
  description="Search, filter, sort, and inspect the complete public FDM and FFF material attribute set."
  canonicalPath={dataHref}
  homeHref={homeHref}
  navigation={navigation}
  breadcrumbs={breadcrumbs}
  footerLinks={footerLinks}
>
  <header class="data-orientation">
    <p class="technical-eyebrow">Advanced material data</p>
    <h1>Explore every material attribute</h1>
    <p class="reading-measure">
      Inspect the same validated facts used by the selector, comparison, and material details.
      Search and filter material membership without hiding fields from retained rows.
    </p>
    <p class="data-count">
      <strong>{model.materials.length}</strong> material families · <strong
        >{model.fields.length}</strong
      > registered attributes
    </p>
    <aside class="data-thermal-caution" aria-label="Thermal comparison caution">
      <strong>Named thermal tests are not directly interchangeable.</strong>
      Practical service guidance, Tg, HDT, Vicat softening temperature, melting point, and other named
      tests retain separate identities and represented methods.
    </aside>
  </header>

  <section class="data-experience" aria-label="Complete material data explorer">
    <noscript
      ><p class="data-noscript">
        Interactive filters and the complete attribute table require JavaScript. Material counts,
        attribute groups, thermal cautions, and methodology guidance remain available in this page.
      </p></noscript
    >
    <DataExplorerIsland payload={payload} client:load />
  </section>

  <section class="data-group-guide" aria-labelledby="data-group-guide-heading">
    <h2 id="data-group-guide-heading">Attribute group guide</h2>
    <p>
      Choose one group at a time to keep the table readable. Every registered attribute remains
      available.
    </p>
    <ol>
      {
        model.groups.map((group) => (
          <li>
            <>
              <strong>{group.label}</strong>
              <span>{group.fieldKeys.length} attributes</span>
            </>
          </li>
        ))
      }
    </ol>
  </section>

  <aside class="data-method-note" aria-labelledby="data-method-heading">
    <h2 id="data-method-heading">Read values with their evidence context</h2>
    <p>
      Fact states, conditions, qualifications, units, and evidence scope are part of each value.
      Product formulations differ, and starting profiles are calibration starting points.
    </p>
    <a href={methodHref}>Read sources, definitions, and methodology</a>
  </aside>
</BaseLayout>
