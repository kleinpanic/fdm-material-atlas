---
import type { GetStaticPaths } from "astro";
import MaterialReference from "../../components/materials/MaterialReference.astro";
import { buildMaterialDetailModels, type MaterialDetailModel } from "../../features/materials/detail-model.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPublicAtlas } from "../../lib/public-atlas.ts";
import { internalHref } from "../../lib/routes.ts";
import "../../styles/material-reference.css";

interface Props { model: MaterialDetailModel }
export const getStaticPaths = (() => {
  const base = import.meta.env.BASE_URL;
  const models = buildMaterialDetailModels(loadPublicAtlas(), base);
  return models.map((model) => ({ params: { slug: model.slug }, props: { model } }));
}) satisfies GetStaticPaths;

const { model } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = internalHref(base, { id: "home" });
const materialsHref = internalHref(base, { id: "materials" });
const methodHref = internalHref(base, { id: "method" });
const navigation = [
  { label: "Material selector", href: homeHref, current: false },
  { label: "Material atlas", href: materialsHref, current: true },
  { label: "Method", href: methodHref, current: false },
] as const;
const breadcrumbs = [{ label: "Home", href: homeHref }, { label: "Materials", href: materialsHref }, { label: model.name, current: true }] as const;
const footerLinks = [{ label: "Material selector", href: homeHref }, { label: "Material atlas", href: materialsHref }, { label: "Method and evidence", href: methodHref }] as const;
---

<BaseLayout
  title={`${model.name} material reference | FDM Material Atlas`}
  description={`Properties, process requirements, starting profile, evidence, and limitations for ${model.name}.`}
  canonicalPath={model.href}
  homeHref={homeHref}
  navigation={navigation}
  breadcrumbs={breadcrumbs}
  footerLinks={footerLinks}
>
  <MaterialReference model={model} />
  <p class="material-return"><a href={materialsHref}>Return to the complete material atlas</a></p>
</BaseLayout>
