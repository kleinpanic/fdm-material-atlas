---
import { AtlasIsland } from "../../features/atlas/AtlasIsland.tsx";
import { buildAtlasPageModel } from "../../features/atlas/model.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPublicAtlas } from "../../lib/public-atlas.ts";
import { internalHref } from "../../lib/routes.ts";
import "../../styles/atlas.css";

const base = import.meta.env.BASE_URL;
const atlas = loadPublicAtlas();
const pageModel = buildAtlasPageModel(atlas, base);
const homeHref = internalHref(base, { id: "home" });
const materialsHref = internalHref(base, { id: "materials" });
const methodHref = internalHref(base, { id: "method" });
const mapHref = internalHref(base, { id: "map" });
const dataHref = internalHref(base, { id: "data" });
const navigation = [
  { label: "Material selector", href: homeHref, current: false },
  { label: "Material atlas", href: materialsHref, current: true },
  { label: "Explore & compare", href: mapHref, current: false },
  { label: "Data", href: dataHref, current: false },
  { label: "Method", href: methodHref, current: false },
] as const;
const breadcrumbs = [
  { label: "Home", href: homeHref },
  { label: "Materials", current: true },
] as const;
const footerLinks = [
  { label: "Material selector", href: homeHref },
  { label: "Material atlas", href: materialsHref },
  { label: "Explore & compare", href: mapHref },
  { label: "Data", href: dataHref },
  { label: "Method and evidence", href: methodHref },
] as const;
---

<BaseLayout
  title="Material atlas | FDM Material Atlas"
  description="Search and filter validated FDM and FFF material families by process requirements and material behavior."
  canonicalPath={materialsHref}
  homeHref={homeHref}
  navigation={navigation}
  breadcrumbs={breadcrumbs}
  footerLinks={footerLinks}
>
  <header class="atlas-orientation">
    <p class="technical-eyebrow">Material atlas</p>
    <h1>Browse validated material families</h1>
    <p class="reading-measure">
      Search all validated materials, then filter by the properties and process requirements that
      matter to your printer and use case.
    </p>
    <p class="atlas-count">
      <strong>{pageModel.rows.length}</strong> material families in this reference.
    </p>
  </header>

  <section class="atlas-experience" aria-label="Complete material atlas">
    <noscript
      ><p class="atlas-fallback" data-state="information">
        Interactive filters are unavailable. All validated materials remain listed below.
      </p></noscript
    >
    <AtlasIsland pageModel={pageModel} client:load />
  </section>

  <aside class="atlas-limitations" aria-labelledby="atlas-limitations-heading">
    <h2 id="atlas-limitations-heading">Use these records as selection guidance</h2>
    <p>
      Filament formulations differ. Check the current TDS and SDS for the exact product. Geometry,
      moisture, load, print orientation, annealing, chamber conditions, and process history can
      change behavior.
    </p>
    <p>
      This atlas is not an engineering safety certification. Named thermal tests are not directly
      interchangeable with practical service-temperature guidance.
    </p>
  </aside>
</BaseLayout>
