---
import { CompareIsland } from "../../components/comparison/CompareIsland.tsx";
import { buildComparisonModel } from "../../features/comparison/model.ts";
import { encodeComparisonPayload } from "../../features/comparison/payload.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPublicAtlas } from "../../lib/public-atlas.ts";
import { internalHref } from "../../lib/routes.ts";
import "../../styles/comparison.css";

const base = import.meta.env.BASE_URL;
const model = buildComparisonModel(loadPublicAtlas(), base);
const payload = encodeComparisonPayload(model);
const homeHref = internalHref(base, { id: "home" });
const materialsHref = internalHref(base, { id: "materials" });
const methodHref = internalHref(base, { id: "method" });
const compareHref = internalHref(base, { id: "compare" });
const dataHref = internalHref(base, { id: "data" });
const mapHref = internalHref(base, { id: "map" });
const navigation = [
  { label: "Material selector", href: homeHref, current: false },
  { label: "Material atlas", href: materialsHref, current: false },
  { label: "Compare", href: compareHref, current: true },
  { label: "Map", href: mapHref, current: false },
  { label: "Data", href: dataHref, current: false },
  { label: "Method", href: methodHref, current: false },
] as const;
const breadcrumbs = [
  { label: "Home", href: homeHref },
  { label: "Compare materials", current: true },
] as const;
const footerLinks = navigation.map(({ label, href }) => ({ label, href }));
---

<BaseLayout
  title="Compare materials | FDM Material Atlas"
  description="Compare two to four FDM and FFF material families with complete thermal, process, and evidence context."
  canonicalPath={compareHref}
  homeHref={homeHref}
  navigation={navigation}
  breadcrumbs={breadcrumbs}
  footerLinks={footerLinks}
>
  <header class="compare-orientation">
    <p class="technical-eyebrow">Material comparison</p>
    <h1>Compare material families</h1>
    <p class="reading-measure">
      Choose two to four materials. Differences retain their fact state, units, conditions,
      qualifications, and evidence scope.
    </p>
    <p class="compare-nonranking">
      <strong>This comparison does not rank a universally better material.</strong> It shows how published
      guidance differs across your selected set.
    </p>
    <aside class="compare-thermal-caution" aria-label="Thermal comparison caution">
      <strong>Named thermal tests are not directly interchangeable.</strong>
      Practical service guidance remains separate from Tg, HDT, Vicat softening temperature, melting point,
      and other named tests. Named observations align only when their represented metric and method are
      compatible.
    </aside>
  </header>

  <section id="comparison-matrix" class="compare-experience" aria-label="Material comparison tool">
    <noscript>
      <p class="compare-noscript">
        JavaScript is required to validate and update a comparison. You can still <a
          href={materialsHref}>browse every material reference</a
        > or <a href={methodHref}>read the comparison method</a>.
      </p>
    </noscript>
    <CompareIsland payload={payload} base={base} client:load />
  </section>

  <aside class="compare-method-note" aria-labelledby="compare-method-heading">
    <h2 id="compare-method-heading">Use comparison as a screening step</h2>
    <p>
      Exact filament formulations differ. Check the product TDS and SDS, then validate
      representative parts under the intended load, moisture, orientation, chamber, and process
      history.
    </p>
    <nav aria-label="Comparison onward links">
      <a href={homeHref}>Return to the material selector</a>
      <a href={materialsHref}>Browse all materials</a>
      <a href={methodHref}>Read sources, definitions, and methodology</a>
    </nav>
  </aside>
</BaseLayout>
