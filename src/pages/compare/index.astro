---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { compactFact } from "../../lib/compact-fact.ts";
import { loadPublicAtlas } from "../../lib/public-atlas.ts";
import { internalHref } from "../../lib/routes.ts";
import "../../styles/reference-tools.css";

const atlas = loadPublicAtlas();
const base = import.meta.env.BASE_URL;
const homeHref = internalHref(base, { id: "home" });
const materialsHref = internalHref(base, { id: "materials" });
const methodHref = internalHref(base, { id: "method" });
const compareHref = `${base}compare/`;
const dataHref = `${base}data/`;
const mapHref = `${base}map/`;
const navigation = [
  { label: "Selector", href: homeHref, current: false },
  { label: "Materials", href: materialsHref, current: false },
  { label: "Compare", href: compareHref, current: true },
  { label: "Map", href: mapHref, current: false },
  { label: "Data", href: dataHref, current: false },
  { label: "Method", href: methodHref, current: false },
] as const;
---

<BaseLayout title="Compare materials | FDM Material Atlas" description="Compare FDM and FFF material families across thermal, mechanical, and process constraints." canonicalPath={compareHref} homeHref={homeHref} navigation={navigation} footerLinks={navigation.map(({ label, href }) => ({ label, href }))}>
  <article class="reference-tool">
    <header class="reference-intro">
      <p class="technical-eyebrow">Comparison matrix</p>
      <h1>Compare material families</h1>
      <p>Scan process gates and application properties together. Open a material for its full evidence, qualifications, tradeoffs, and starting profile.</p>
    </header>
    <aside class="comparison-note"><strong>Thermal comparison caution:</strong> service guidance is not the same as Tg, HDT, Vicat softening temperature, or melting point. Compare named metrics only when methods and conditions match.</aside>
    <div class="table-frame" tabindex="0" role="region" aria-label="Scrollable material comparison matrix">
      <table class="material-matrix">
        <caption>Screening comparison for all {atlas.materials.length} public material records.</caption>
        <thead><tr><th scope="col">Material</th><th scope="col">Service guidance</th><th scope="col">Chemical resistance</th><th scope="col">Impact</th><th scope="col">Creep / sustained load</th><th scope="col">Warp</th><th scope="col">Dimensional stability</th><th scope="col">Difficulty</th><th scope="col">Enclosure</th><th scope="col">Drying</th></tr></thead>
        <tbody>
          {atlas.materials.map((material) => (
            <tr>
              <th scope="row"><a href={internalHref(base, { id: "material", slug: material.slug })}>{material.name}</a></th>
              <td>{compactFact(material.serviceTemperature)}</td>
              <td>{compactFact(material.properties.chemicalResistance)}</td>
              <td>{compactFact(material.properties.impactResistance)}</td>
              <td>{compactFact(material.properties.creepSustainedLoad)}</td>
              <td>{compactFact(material.properties.warpTendency)}</td>
              <td>{compactFact(material.properties.dimensionalStability)}</td>
              <td>{compactFact(material.process.printDifficulty)}</td>
              <td>{compactFact(material.process.enclosure)}</td>
              <td>{compactFact(material.process.dryingPriority)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </article>
</BaseLayout>
