---
import { SelectorIsland } from "../components/selector/SelectorIsland.tsx";
import { SelectorStaticResults } from "../components/selector/SelectorStaticResults.tsx";
import { buildSelectorBootstrap } from "../features/selector/bootstrap.ts";
import { decodeSelectorClientModel } from "../features/selector/client-model.ts";
import { buildSelectorPageModel } from "../features/selector/page-model.ts";
import { prepareSelectorPresentationEvaluator } from "../features/selector/runtime-evaluator.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPublicAtlas } from "../lib/public-atlas.ts";
import { PUBLIC_ROUTE_REGISTRY } from "../lib/public-route-registry.ts";
import { internalHref } from "../lib/routes.ts";
import "../styles/selector.css";

const base = import.meta.env.BASE_URL;
const atlas = loadPublicAtlas();
const pageModel = buildSelectorPageModel(atlas, base, PUBLIC_ROUTE_REGISTRY);
const runtimeModel = decodeSelectorClientModel(pageModel);
const defaultPresentation = prepareSelectorPresentationEvaluator(runtimeModel)(
  runtimeModel.defaults,
);
const selectorBootstrap = buildSelectorBootstrap(runtimeModel, defaultPresentation);
const homeHref = internalHref(base, { id: "home" });
const materialsHref = internalHref(base, { id: "materials" });
const compareHref = internalHref(base, { id: "compare" });
const mapHref = internalHref(base, { id: "map" });
const dataHref = internalHref(base, { id: "data" });
const methodHref = internalHref(base, { id: "method" });

const navigation = [
  { label: "Material selector", href: homeHref, current: true },
  { label: "Materials", href: materialsHref, current: false },
  { label: "Compare", href: compareHref, current: false },
  { label: "Map", href: mapHref, current: false },
  { label: "Data", href: dataHref, current: false },
  { label: "Method", href: methodHref, current: false },
] as const;

const footerLinks = [
  { label: "Material selector", href: homeHref },
  { label: "Materials", href: materialsHref },
  { label: "Compare", href: compareHref },
  { label: "Map", href: mapHref },
  { label: "Data", href: dataHref },
  { label: "Method", href: methodHref },
] as const;
---

<BaseLayout
  title="Material selector | FDM Material Atlas"
  description="Select FDM and FFF material families by application goal and printer process constraints."
  canonicalPath={homeHref}
  homeHref={homeHref}
  navigation={navigation}
  footerLinks={footerLinks}
>
  <header class="selector-orientation">
    <p class="technical-eyebrow">Material selector</p>
    <h1>Choose a material that fits your process</h1>
    <p class="selector-task-description">
      Set an application goal and the process constraints your printer can meet. Results explain
      alignment points and every hard constraint that removes a material.
    </p>
    <aside class="selector-alignment-notice" aria-labelledby="selector-alignment-heading">
      <span aria-hidden="true">i</span>
      <div>
        <h2 id="selector-alignment-heading">What the score means</h2>
        <p>
          Alignment scores reflect only the criteria you selected. They do not rank universal
          material quality, strength, safety, or engineering suitability.
        </p>
      </div>
    </aside>
  </header>

  <section class="selector-experience" aria-label="Material selection worksheet">
    <noscript>
      <p class="selector-noscript">
        Interactive filtering needs JavaScript. The published default results remain available
        below.
      </p>
    </noscript>
    <div class="selector-island">
      <SelectorIsland pageModel={pageModel} bootstrap={selectorBootstrap} client:load />
      <div
        id="selector-results-mount"
        class="selector-results-mount selector-results-host"
        data-selector-results-owner="server"
        aria-busy="false"
      >
        <SelectorStaticResults pageModel={runtimeModel} presentation={defaultPresentation} />
      </div>
    </div>
  </section>
</BaseLayout>
