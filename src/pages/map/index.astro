---
import { MapExplorerIsland } from "../../components/map/MapExplorerIsland.tsx";
import { compileMapProjection } from "../../features/map/projection.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPublicAtlas } from "../../lib/public-atlas.ts";
import { internalHref } from "../../lib/routes.ts";
import "../../styles/map-board.css";

const base = import.meta.env.BASE_URL;
const atlas = loadPublicAtlas();
const projection = compileMapProjection(atlas, base);
const homeHref = internalHref(base, { id: "home" });
const materialsHref = internalHref(base, { id: "materials" });
const compareHref = internalHref(base, { id: "compare" });
const mapHref = internalHref(base, { id: "map" });
const dataHref = internalHref(base, { id: "data" });
const methodHref = internalHref(base, { id: "method" });
const navigation = [
  { label: "Selector", href: homeHref, current: false },
  { label: "Materials", href: materialsHref, current: false },
  { label: "Compare", href: compareHref, current: false },
  { label: "Map", href: mapHref, current: true },
  { label: "Data", href: dataHref, current: false },
  { label: "Method", href: methodHref, current: false },
] as const;
---

<BaseLayout
  title="Decision maps | FDM Material Atlas"
  description="Trace eight data-derived material decision paths and inspect thermal, process-gate, impact, and flexibility relationships."
  canonicalPath={mapHref}
  homeHref={homeHref}
  navigation={navigation}
  breadcrumbs={[{ label: "Home", href: homeHref }, { label: "Decision maps", current: true }]}
  footerLinks={navigation.map(({ label, href }) => ({ label, href }))}
>
  <article class="map-page">
    <header class="map-hero">
      <p class="technical-eyebrow">Material decision maps</p>
      <h1>Trace material choices through properties and process gates</h1>
      <p class="map-hero__lede">
        Follow a use need to the properties, live material candidates, and process checks that require verification. Then inspect selected scientific relationships without combining unlike measurements.
      </p>
    </header>

    <aside class="map-caution" aria-labelledby="map-caution-heading">
      <span class="map-caution__mark" aria-hidden="true">!</span>
      <div>
        <h2 id="map-caution-heading">Read paths and plots as guidance</h2>
        <p>Candidate status means that a material satisfies the published lane rule. It is not a universal recommendation, safety approval, or engineering certification.</p>
      </div>
    </aside>

    <nav class="map-mode-index" aria-label="Explore visualization modes">
      <p class="map-index-label">Explore visualization modes</p>
      <ol>
        <li><a href={projection.modeFragments["decision-paths"]}><span aria-hidden="true">01</span>Decision paths</a></li>
        <li><a href={projection.modeFragments["thermal-ranges"]}><span aria-hidden="true">02</span>Thermal guidance</a></li>
        <li><a href={projection.modeFragments["process-gates"]}><span aria-hidden="true">03</span>Process gates</a></li>
        <li><a href={projection.modeFragments["impact-flex-space"]}><span aria-hidden="true">04</span>Impact + flexibility</a></li>
      </ol>
    </nav>

    <nav class="map-lane-directory" aria-label="Decision path index">
      <header>
        <p class="technical-eyebrow">Decision paths</p>
        <h2>Start with the need</h2>
        <p>Each path preserves the canonical need, properties, live candidates, and verification gates.</p>
      </header>
      <ol>
        {projection.lanes.map((lane, index) => (
          <li>
            <a href={lane.href}>
              <span class="map-lane-directory__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span class="map-lane-directory__copy">
                <strong>{lane.label}</strong>
                <small>{lane.candidates.length} candidates · {lane.processGates.length} gates</small>
              </span>
              <span class="map-lane-directory__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="map-preparation" role="status">
      <span class="map-preparation__pulse" aria-hidden="true"></span>
      <p>Interactive map controls are preparing. Every path and structured table is already available.</p>
    </div>
    <noscript>
      <p class="map-noscript">Interactive highlighting is unavailable. All decision paths and structured visualization data remain readable below.</p>
    </noscript>

    <MapExplorerIsland projection={projection} client:visible={{ rootMargin: "200px" }} />

    <footer class="map-method-note">
      <p class="technical-eyebrow">Interpretation boundary</p>
      <h2>Keep measurements in context</h2>
      <p>Thermal metrics, qualitative property guidance, and process gates answer different questions. Review definitions, evidence conventions, and limitations before making a consequential choice.</p>
      <a href={projection.methodHref}>Review method and thermal definitions</a>
    </footer>
  </article>
</BaseLayout>
