---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { deriveDecisionLaneMembership } from "../../domain/decision-lanes/membership.ts";
import { loadPublicAtlas } from "../../lib/public-atlas.ts";
import { internalHref } from "../../lib/routes.ts";
import "../../styles/reference-tools.css";

const atlas = loadPublicAtlas();
const lanes = deriveDecisionLaneMembership(atlas);
const materialById = new Map(atlas.materials.map((material) => [material.id, material]));
const base = import.meta.env.BASE_URL;
const homeHref = internalHref(base, { id: "home" });
const materialsHref = internalHref(base, { id: "materials" });
const methodHref = internalHref(base, { id: "method" });
const compareHref = `${base}compare/`;
const dataHref = `${base}data/`;
const mapHref = `${base}map/`;
const navigation = [
  { label: "Selector", href: homeHref, current: false },
  { label: "Materials", href: materialsHref, current: false },
  { label: "Compare", href: compareHref, current: false },
  { label: "Map", href: mapHref, current: true },
  { label: "Data", href: dataHref, current: false },
  { label: "Method", href: methodHref, current: false },
] as const;
---

<BaseLayout title="Material decision map | FDM Material Atlas" description="Eight data-derived decision paths from printing need to candidate materials and process gates." canonicalPath={mapHref} homeHref={homeHref} navigation={navigation} footerLinks={navigation.map(({ label, href }) => ({ label, href }))}>
  <article class="reference-tool">
    <header class="reference-intro">
      <p class="technical-eyebrow">Decision-path map</p>
      <h1>Move from need to verification</h1>
      <p>Each lane derives its candidates from the canonical material facts. A candidate is a starting point, not a certification: verify the exact product, geometry, environment, and process.</p>
    </header>
    <div class="lane-grid">
      {lanes.map((lane) => (
        <section id={lane.id} class="lane-card" aria-labelledby={`${lane.id}-heading`}>
          <p class="technical-eyebrow">Need → check → candidates → verify</p>
          <h2 id={`${lane.id}-heading`}>{lane.label}</h2>
          <p>{lane.need}</p>
          <dl class="lane-flow">
            <dt>Check</dt>
            <dd>{lane.propertyChecks.join(", ")}</dd>
            <dt>Live candidates</dt>
            <dd>
              {lane.candidateMaterialIds.map((materialId, index) => {
                const material = materialById.get(materialId);
                if (material === undefined) throw new Error("MAP_MATERIAL_MISSING");
                return <><a href={internalHref(base, { id: "material", slug: material.slug })}>{material.name}</a>{index < lane.candidateMaterialIds.length - 1 ? ", " : ""}</>;
              })}
            </dd>
            <dt>Process gates</dt>
            <dd>{lane.processGates.map(({ label }) => label).join("; ") || "No additional gate recorded"}</dd>
            <dt>Verify</dt>
            <dd>{lane.verification.join(" ")}</dd>
          </dl>
          {lane.indeterminateMaterialIds.length > 0 && (
            <details>
              <summary>{lane.indeterminateMaterialIds.length} materials need more evidence</summary>
              <p>These records are not treated as candidates because the required property is unknown or conditional.</p>
            </details>
          )}
        </section>
      ))}
    </div>
  </article>
</BaseLayout>
