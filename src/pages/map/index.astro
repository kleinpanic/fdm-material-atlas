---
import { MapExplorer, MapExplorerIsland } from "../../components/map/MapExplorerIsland.tsx";
import { CompareIsland } from "../../components/comparison/CompareIsland.tsx";
import { buildComparisonModel } from "../../features/comparison/model.ts";
import { encodeComparisonPayload } from "../../features/comparison/payload.ts";
import { encodeMapProjectionPayload } from "../../features/map/payload.ts";
import { compileMapProjection } from "../../features/map/projection.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPublicAtlas } from "../../lib/public-atlas.ts";
import { internalHref } from "../../lib/routes.ts";
import "../../styles/map-board.css";
import "../../styles/comparison.css";

const base = import.meta.env.BASE_URL;
const atlas = loadPublicAtlas();
const projection = compileMapProjection(atlas, base);
const payload = encodeMapProjectionPayload(projection);
const comparisonPayload = encodeComparisonPayload(buildComparisonModel(atlas, base));
const homeHref = internalHref(base, { id: "home" });
const materialsHref = internalHref(base, { id: "materials" });
const mapHref = internalHref(base, { id: "map" });
const dataHref = internalHref(base, { id: "data" });
const methodHref = internalHref(base, { id: "method" });
const navigation = [
  { label: "Selector", href: homeHref, current: false },
  { label: "Materials", href: materialsHref, current: false },
  { label: "Explore & compare", href: mapHref, current: true },
  { label: "Data", href: dataHref, current: false },
  { label: "Method", href: methodHref, current: false },
] as const;
---

<BaseLayout
  title="Explore and compare materials | FDM Material Atlas"
  description="Compare selected FDM materials, trace eight data-derived decision paths, and inspect thermal, process, impact, and flexibility relationships."
  canonicalPath={mapHref}
  homeHref={homeHref}
  navigation={navigation}
  breadcrumbs={[
    { label: "Home", href: homeHref },
    { label: "Explore and compare", current: true },
  ]}
  footerLinks={navigation.map(({ label, href }) => ({ label, href }))}
>
  <article class="map-page">
    <header class="map-hero">
      <p class="technical-eyebrow">Material exploration workbench</p>
      <h1>Compare materials, then trace the engineering tradeoffs</h1>
      <p class="map-hero__lede">
        Select two to four materials for a direct comparison, or follow a use need through live
        candidates, properties, and process checks. Every view keeps unlike thermal measurements
        separate.
      </p>
    </header>

    <aside class="map-caution" aria-labelledby="map-caution-heading">
      <span class="map-caution__mark" aria-hidden="true">!</span>
      <div>
        <h2 id="map-caution-heading">Read paths and plots as guidance</h2>
        <p>
          Candidate status means that a material satisfies the published lane rule. It is not a
          universal recommendation, safety approval, or engineering certification.
        </p>
      </div>
    </aside>

    <section id="comparison-matrix" class="map-comparison" aria-labelledby="map-comparison-heading">
      <header class="map-comparison__header">
        <p class="technical-eyebrow">Selected comparison</p>
        <h2 id="map-comparison-heading">Compare two to four materials</h2>
        <p>
          Choose the material families you want to inspect together. Differences retain units,
          conditions, qualifications, fact state, and evidence scope.
        </p>
      </header>
      <noscript>
        <p class="compare-noscript">
          JavaScript is required to update a selected comparison. The decision maps and complete
          material records remain available below.
        </p>
      </noscript>
      <CompareIsland payload={comparisonPayload} base={base} historyPath={mapHref} client:load />
    </section>

    <nav class="map-mode-index" aria-label="Explore visualization modes">
      <p class="map-index-label">Explore relationship views</p>
      <ol>
        <li>
          <a href={projection.modeFragments["decision-paths"]}
            ><span aria-hidden="true">01</span>Decision paths</a
          >
        </li>
        <li>
          <a href={projection.modeFragments["thermal-ranges"]}
            ><span aria-hidden="true">02</span>Thermal guidance</a
          >
        </li>
        <li>
          <a href={projection.modeFragments["process-gates"]}
            ><span aria-hidden="true">03</span>Process gates</a
          >
        </li>
        <li>
          <a href={projection.modeFragments["impact-flex-space"]}
            ><span aria-hidden="true">04</span>Impact + flexibility</a
          >
        </li>
      </ol>
    </nav>

    <nav class="map-lane-directory" aria-label="Decision path index">
      <header>
        <p class="technical-eyebrow">Decision paths</p>
        <h2>Decision paths</h2>
        <p>
          Choose one of eight needs to inspect the canonical rule, all live candidates, and every
          linked process gate.
        </p>
      </header>
      <ol>
        {
          projection.lanes.map((lane, index) => (
            <li>
              <a href={lane.href}>
                <span class="map-lane-directory__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="map-lane-directory__copy">
                  <strong>{lane.label}</strong>
                  <small>
                    {lane.candidates.length} candidates · {lane.processGates.length} gates
                  </small>
                </span>
                <span class="map-lane-directory__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <noscript>
      <p class="map-noscript">
        Interactive highlighting is unavailable. All decision paths and structured visualization
        data remain readable below.
      </p>
      <MapExplorer projection={projection} />
    </noscript>

    <MapExplorerIsland payload={payload} client:load />

    <footer class="map-method-note">
      <p class="technical-eyebrow">Interpretation boundary</p>
      <h2>Keep measurements in context</h2>
      <p>
        Thermal metrics, qualitative property guidance, and process gates answer different
        questions. Review definitions, evidence conventions, and limitations before making a
        consequential choice.
      </p>
      <a href={projection.methodHref}>Review method and thermal definitions</a>
    </footer>
  </article>
</BaseLayout>
