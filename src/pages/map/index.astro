---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DecisionBoard from "../../components/map/DecisionBoard.astro";
import { deriveDecisionLaneMembership } from "../../domain/decision-lanes/membership.ts";
import { loadPublicAtlas } from "../../lib/public-atlas.ts";
import { internalHref } from "../../lib/routes.ts";
import "../../styles/map-board.css";

const atlas = loadPublicAtlas();
const lanes = deriveDecisionLaneMembership(atlas);
const materialById = new Map(atlas.materials.map((material) => [material.id, material]));
const distinctCandidateCount = new Set(lanes.flatMap(({ candidateMaterialIds }) => candidateMaterialIds)).size;
const processGateCount = new Set(lanes.flatMap(({ processGates }) => processGates.map(({ id }) => id))).size;
const base = import.meta.env.BASE_URL;
const homeHref = internalHref(base, { id: "home" });
const materialsHref = internalHref(base, { id: "materials" });
const methodHref = internalHref(base, { id: "method" });
const compareHref = internalHref(base, { id: "compare" });
const dataHref = internalHref(base, { id: "data" });
const mapHref = internalHref(base, { id: "map" });
const navigation = [
  { label: "Selector", href: homeHref, current: false },
  { label: "Materials", href: materialsHref, current: false },
  { label: "Compare", href: compareHref, current: false },
  { label: "Map", href: mapHref, current: true },
  { label: "Data", href: dataHref, current: false },
  { label: "Method", href: methodHref, current: false },
] as const;
---

<BaseLayout title="Material decision map | FDM Material Atlas" description="Eight data-derived decision paths from printing need to candidate materials and process gates." canonicalPath={mapHref} homeHref={homeHref} navigation={navigation} footerLinks={navigation.map(({ label, href }) => ({ label, href }))}>
  <article class="map-page">
    <header class="map-hero">
      <div class="map-hero__copy">
        <p class="technical-eyebrow">Material routing board / 08 paths</p>
        <h1>Start with the job. End with what to verify.</h1>
        <p class="map-hero__lede">Trace a real printing need through the properties that matter, the materials that currently match, and the equipment or evidence checks that remain.</p>
      </div>
      <dl class="map-hero__stats" aria-label="Decision map coverage">
        <div><dt>Decision paths</dt><dd>{lanes.length}</dd></div>
        <div><dt>Materials routed</dt><dd>{distinctCandidateCount}</dd></div>
        <div><dt>Process gates</dt><dd>{processGateCount}</dd></div>
      </dl>
    </header>

    <div class="map-principle" role="note">
      <strong>Read this first</strong>
      <p>A match is a defensible place to begin—not a product certification. Exact formulation, geometry, moisture, orientation, load, and process history can change the result.</p>
    </div>

    <DecisionBoard lanes={lanes} materials={materialById} base={base} />
  </article>
</BaseLayout>
